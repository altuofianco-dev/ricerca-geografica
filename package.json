{
  "name": "ricerca-geografica",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply ricerca-geografica --local",
    "db:migrate:remote": "wrangler d1 migrations apply ricerca-geografica --remote",
    "cf-typegen": "wrangler types",
    "prova:google": "node scripts/prova-google.mjs",
    "admin:crea:local": "node scripts/crea-admin.mjs --local",
    "admin:crea:remote": "node scripts/crea-admin.mjs --remote"
  },
  "dependencies": {
    "hono": "^4.13.11",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.2",
    "@cloudflare/workers-types": "^5.20260930.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^4.1.11",
    "wrangler": "^4.144.0"
  }
}
